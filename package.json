{
  "name": "llewellyn-professional-profile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:pdfs": "./scripts/build-cv-pdfs.sh",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test tests/data-integrity.test.mjs tests/interaction-logic.test.mjs",
    "test:dist": "node --test tests/static-output.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:dist && npm run check:links"
  },
  "dependencies": {
    "astro": "7.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "1.7.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
