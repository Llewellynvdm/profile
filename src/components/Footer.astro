---
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <a class="brand footer-brand" href={base}>
        <img
          class="site-icon"
          src={`${base}assets/favicon.svg`}
          alt=""
          width="42"
          height="42"
          loading="lazy"
          decoding="async"
        />
        <span>
          <strong>Llewellyn van der Merwe</strong>
          <small>Systems that build systems.</small>
        </span>
      </a>
      <p class="footer-note">
        Public evidence is presented as an inspectable lower bound. Confidential commercial and
        institutional systems remain private by design.
      </p>
    </div>
    <nav aria-label="Footer navigation">
      <h2>Explore</h2>
      <a href={`${base}#capabilities`}>Capabilities</a>
      <a href={`${base}#projects`}>Case studies</a>
      <a href={`${base}evidence/`}>Evidence catalogue</a>
      <a href={`${base}record/`}>Exhaustive record</a>
      <a href={`${base}cv/`}>Executive CV</a>
    </nav>
    <nav aria-label="Professional links">
      <h2>Connect</h2>
      <a href="https://t.me/llewellynvdm" rel="noreferrer"
        >Telegram <span aria-hidden="true">↗</span></a
      >
      <a href="https://github.com/Llewellynvdm" rel="noreferrer"
        >GitHub <span aria-hidden="true">↗</span></a
      >
      <a href="https://vdm.io/llewellyn" rel="noreferrer"
        >vdm.io <span aria-hidden="true">↗</span></a
      >
      <a href="https://git.vdm.dev/" rel="noreferrer"
        >Company engineering estate <span aria-hidden="true">↗</span></a
      >
    </nav>
  </div>
  <div class="footer-base">
    <span>© {new Date().getFullYear()} Llewellyn van der Merwe</span>
    <a href="#main-content">Back to top ↑</a>
  </div>
</footer>
