---
import BaseLayout from "../../layouts/BaseLayout.astro";
import profile from "../../data/profile.json";
import projects from "../../data/projects.json";
import repositories from "../../data/repositories.json";

const base = import.meta.env.BASE_URL;
const featured = projects.filter((project) => project.featured);
const publicEstates = [
  {
    owner: "joomengine",
    label: "JoomEngine",
    scope:
      "JCB platform, Power registries, packages, Joomla systems, Docker, documentation, and MCP.",
    url: "https://github.com/joomengine",
  },
  {
    owner: "getbible",
    label: "GetBible",
    scope:
      "Native engine, APIs, builders, libraries, Joomla, Telegram, MCP, and client applications.",
    url: "https://github.com/getbible",
  },
  {
    owner: "octoleo",
    label: "Octoleo",
    scope:
      "Shell products for deployment, repository automation, packaging, containers, and operations.",
    url: "https://github.com/octoleo",
  },
  {
    owner: "trueChristian",
    label: "TrueChristian",
    scope: "Publication automation, Joomla delivery, sermon systems, and Python print production.",
    url: "https://github.com/trueChristian",
  },
  {
    owner: "Llewellynvdm",
    label: "Personal public record",
    scope: "Earlier Joomla, Shell, C++, Python, integration, and developer-tool projects.",
    url: "https://github.com/Llewellynvdm",
  },
].map((estate) => ({
  ...estate,
  count: repositories.filter((repository) => repository.owner === estate.owner).length,
}));
---

<BaseLayout
  title="Detailed CV | Llewellyn van der Merwe"
  description="Detailed, evidence-backed professional record of Llewellyn van der Merwe, Senior Architectural Engineer of Intelligent Software and Systems."
  pageClass="cv-page"
>
  <article class="cv-document section-shell">
    <header class="cv-header">
      <div class="cv-identity">
        <p class="eyebrow">Detailed professional record</p>
        <h1>{profile.identity.name}</h1>
        <p class="cv-title">{profile.identity.title}</p>
        <p class="cv-summary">{profile.identity.summary}</p>
      </div>
      <div class="cv-contact">
        <img
          src={`${base}assets/llewellyn-van-der-merwe.webp`}
          width="180"
          height="180"
          alt="Llewellyn van der Merwe"
        />
        <address>
          <span>{profile.identity.location}</span>
          <a href={`mailto:${profile.identity.email}`}>{profile.identity.email}</a>
          <a href={`tel:${profile.identity.telephone.replaceAll(" ", "")}`}
            >{profile.identity.telephone}</a
          >
          <a href={profile.identity.github}>github.com/Llewellynvdm</a>
        </address>
      </div>
      <div class="cv-tools" data-print-hidden>
        <button class="button button-primary" type="button" data-print>Print / save as PDF</button>
        <a
          class="button button-secondary"
          href={`${base}documents/llewellyn-van-der-merwe-executive-cv.pdf`}
          >Original executive CV</a
        >
        <a class="button button-secondary" href={`${base}evidence/`}>Public evidence index</a>
      </div>
    </header>

    <div class="cv-grid">
      <div class="cv-main">
        <section>
          <p class="eyebrow">Executive value</p>
          <h2>Systems that build systems</h2>
          <p class="large-copy">{profile.identity.positioning}</p>
          <div class="cv-differentiators">
            {
              profile.differentiators.map((item) => (
                <article>
                  <h3>{item.label}</h3>
                  <p>{item.detail}</p>
                </article>
              ))
            }
          </div>
          <dl class="cv-evidence-summary">
            <div>
              <dt>Curated public evidence</dt>
              <dd>{repositories.length} repositories</dd>
            </div>
            <div>
              <dt>Engineering estates</dt>
              <dd>{publicEstates.length} public scopes</dd>
            </div>
            <div>
              <dt>Professional scope</dt>
              <dd>Architecture through operations</dd>
            </div>
          </dl>
        </section>

        <section>
          <p class="eyebrow">Professional record</p>
          <h2>Selected roles and systems</h2>
          <div class="record-list">
            {
              profile.professionalRecord.map((item) => (
                <article>
                  <div>
                    <h3>{item.name}</h3>
                    <span>{item.period}</span>
                  </div>
                  <strong>{item.role}</strong>
                  <p>{item.scope}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section>
          <p class="eyebrow">Public engineering estates</p>
          <h2>Maintained systems, libraries, tools, and outputs</h2>
          <p>
            The public record is a representative professional calling card. It does not expose the
            additional proprietary and private systems maintained for clients and internal use.
          </p>
          <div class="cv-estates">
            {
              publicEstates.map((estate) => (
                <article>
                  <div>
                    <h3>{estate.label}</h3>
                    <span>{estate.count} repositories</span>
                  </div>
                  <p>{estate.scope}</p>
                  <a href={estate.url}>{estate.url.replace("https://", "")}</a>
                </article>
              ))
            }
          </div>
        </section>

        <section>
          <p class="eyebrow">Flagship technical work</p>
          <h2>Architecture with direct source evidence</h2>
          <div class="cv-projects">
            {
              featured.map((project) => (
                <article>
                  <div>
                    <h3>{project.name}</h3>
                    <span>{project.status}</span>
                  </div>
                  <p>{project.summary}</p>
                  <p>
                    <strong>Role:</strong> {project.role}
                  </p>
                  <a href={`${base}projects/${project.slug}/`}>Technical brief →</a>
                </article>
              ))
            }
          </div>
        </section>

        <section>
          <p class="eyebrow">Open-source leadership</p>
          <h2>Service, maintenance, and communication</h2>
          <ul class="quality-list">
            {profile.service.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>

      <aside class="cv-sidebar">
        <section>
          <p class="eyebrow">Core capabilities</p>
          <h2>Engineering scope</h2>
          <ul class="cv-capabilities">
            {
              profile.capabilities.map((capability) => (
                <li>
                  <strong>{capability.title}</strong>
                  <span>{capability.summary}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <p class="eyebrow">Languages & platforms</p>
          <h2>Applied technologies</h2>
          <ul class="cv-technologies">
            {
              profile.technologyDomains.map((technology) => (
                <li>
                  <strong>{technology.name}</strong>
                  <span>{technology.context}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <p class="eyebrow">Education</p>
          <h2>Formal and continuing study</h2>
          <div class="education-list">
            {
              profile.education.map((item) => (
                <article>
                  <span>{item.year}</span>
                  <h3>{item.title}</h3>
                  <p>{item.institution}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section>
          <p class="eyebrow">Evidence note</p>
          <h2>Factual scope</h2>
          <p>
            This web CV separates Joomla engineering since 2008 from official Joomla volunteer
            service since 2016. C++ repositories from 2020 are public evidence, not the start of
            native-language experience. Public Git figures are scoped lower bounds, not claims about
            surviving code, hours, or quality.
          </p>
          <a href={`${base}evidence/`}>Browse all {repositories.length} evidence records</a>
          <a href={`${base}documents/llewellyn-van-der-merwe-professional-dossier.pdf`}>
            Download professional dossier
          </a>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
