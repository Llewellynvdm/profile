---
import BaseLayout from "../../layouts/BaseLayout.astro";
import projects from "../../data/projects.json";
import repositories from "../../data/repositories.json";

const base = import.meta.env.BASE_URL;
const tierOrder = { flagship: 0, system: 1, catalogue: 2 };
const orderedRepositories = [...repositories].sort(
  (left, right) =>
    tierOrder[left.tier as keyof typeof tierOrder] -
      tierOrder[right.tier as keyof typeof tierOrder] ||
    left.owner.localeCompare(right.owner) ||
    left.title.localeCompare(right.title),
);
const owners = [...new Set(repositories.map((repository) => repository.owner))];
const languages = [...new Set(repositories.map((repository) => repository.language))].sort();
const flagshipCount = repositories.filter((repository) => repository.tier === "flagship").length;
const sourceCount = repositories.filter((repository) => repository.tier !== "catalogue").length;
const projectMap = new Map(projects.map((project) => [project.id, project]));

const ownerLabels = {
  Llewellynvdm: "Personal record",
  getbible: "GetBible",
  joomengine: "JoomEngine",
  octoleo: "Octoleo",
  trueChristian: "TrueChristian",
};
---

<BaseLayout
  title="Public Engineering Evidence | Llewellyn van der Merwe"
  description="A complete, searchable, evidence-layered index of Llewellyn van der Merwe's authored and directly maintained public engineering repositories."
  pageClass="evidence-page"
>
  <header class="evidence-hero section-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Profile</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Public evidence</span>
    </nav>
    <div class="evidence-hero-grid">
      <div>
        <p class="eyebrow">Public engineering record</p>
        <h1>Inspect the systems, then follow the source.</h1>
        <p class="evidence-lead">
          This catalogue covers authored and directly maintained work across JoomEngine, GetBible,
          Octoleo, TrueChristian, and the personal public record. It distinguishes flagship source
          systems from supporting projects and generated or historical outputs.
        </p>
      </div>
      <dl class="evidence-metrics">
        <div>
          <dt>Curated repositories</dt>
          <dd>{repositories.length}</dd>
        </div>
        <div>
          <dt>Flagship systems</dt>
          <dd>{flagshipCount}</dd>
        </div>
        <div>
          <dt>Source systems</dt>
          <dd>{sourceCount}</dd>
        </div>
        <div>
          <dt>Public estates</dt>
          <dd>{owners.length}</dd>
        </div>
      </dl>
    </div>
  </header>

  <section class="section-shell evidence-method" aria-labelledby="evidence-method-title">
    <div>
      <p class="eyebrow">Evidence hierarchy</p>
      <h2 id="evidence-method-title">Large numbers do not replace engineering context.</h2>
    </div>
    <div class="tier-explainer">
      <article>
        <span class="tier-dot tier-dot-flagship" aria-hidden="true"></span>
        <div>
          <h3>Flagship</h3>
          <p>
            Substantial source systems that best demonstrate architecture, implementation, and
            stewardship.
          </p>
        </div>
      </article>
      <article>
        <span class="tier-dot tier-dot-system" aria-hidden="true"></span>
        <div>
          <h3>Supporting system</h3>
          <p>
            Libraries, integrations, applications, and operational tools with direct technical
            relevance.
          </p>
        </div>
      </article>
      <article>
        <span class="tier-dot tier-dot-catalogue" aria-hidden="true"></span>
        <div>
          <h3>Catalogue</h3>
          <p>
            Generated packages, static APIs, mirrors, organization metadata, and historical records
            retained for completeness.
          </p>
        </div>
      </article>
    </div>
    <p class="evidence-scope-note">
      Repository creation dates indicate public evidence, not the beginning of professional
      experience. Generated JSON and package volume is deliberately excluded from source-code
      prominence. Public repositories are professional calling cards; additional proprietary and
      private systems are not exposed here.
    </p>
  </section>

  <section
    class="section-shell section-block repository-section"
    id="repository-index"
    aria-labelledby="repository-title"
  >
    <div class="section-intro">
      <div>
        <p class="eyebrow">Repository evidence index</p>
        <h2 id="repository-title">Complete, filterable, and directly linked.</h2>
      </div>
      <p>
        Search the record or narrow it by public estate, evidence tier, and principal language. Core
        content remains available when JavaScript is disabled.
      </p>
    </div>

    <form class="repository-filters" data-repository-filters>
      <label class="repository-search">
        <span>Search repositories and engineering context</span>
        <input
          type="search"
          name="query"
          placeholder="OctoJoom, C++, deployment, MCP…"
          autocomplete="off"
          data-repository-query
        />
      </label>
      <label>
        <span>Public estate</span>
        <select name="owner" data-repository-owner>
          <option value="all">All estates</option>
          {
            owners.map((owner) => (
              <option value={owner}>
                {ownerLabels[owner as keyof typeof ownerLabels] ?? owner}
              </option>
            ))
          }
        </select>
      </label>
      <label>
        <span>Evidence tier</span>
        <select name="tier" data-repository-tier>
          <option value="all">All tiers</option>
          <option value="flagship">Flagship systems</option>
          <option value="system">Supporting systems</option>
          <option value="catalogue">Catalogue and history</option>
        </select>
      </label>
      <label>
        <span>Principal language</span>
        <select name="language" data-repository-language>
          <option value="all">All languages</option>
          {languages.map((language) => <option value={language}>{language}</option>)}
        </select>
      </label>
      <button class="button button-secondary repository-reset" type="reset" data-repository-reset>
        Reset filters
      </button>
    </form>

    <div class="repository-result-bar">
      <p aria-live="polite">
        Showing <strong data-repository-count>{orderedRepositories.length}</strong> of {
          repositories.length
        } repositories
      </p>
      <a href="https://github.com/Llewellynvdm" target="_blank" rel="noopener noreferrer">
        Open GitHub profile <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="repository-grid" data-repository-grid>
      {
        orderedRepositories.map((repository) => {
          const linkedProject = repository.projectId
            ? projectMap.get(repository.projectId)
            : undefined;
          const searchCorpus = [
            repository.title,
            repository.name,
            repository.owner,
            repository.language,
            repository.type,
            repository.summary,
            ...repository.signals,
          ].join(" ");

          return (
            <article
              class={`repository-card repository-card-${repository.tier}`}
              data-repository-card
              data-owner={repository.owner}
              data-tier={repository.tier}
              data-language={repository.language}
              data-search={searchCorpus}
            >
              <div class="repository-card-head">
                <span class={`repository-tier repository-tier-${repository.tier}`}>
                  {repository.tier === "flagship"
                    ? "Flagship"
                    : repository.tier === "system"
                      ? "System"
                      : "Catalogue"}
                </span>
                <span class="repository-year">Public since {repository.since}</span>
              </div>
              <p class="repository-owner">
                {repository.owner} / {repository.name}
              </p>
              <h3>{repository.title}</h3>
              <p class="repository-summary">{repository.summary}</p>
              <dl class="repository-meta">
                <div>
                  <dt>Principal language</dt>
                  <dd>{repository.language}</dd>
                </div>
                <div>
                  <dt>Engineering role</dt>
                  <dd>{repository.type}</dd>
                </div>
              </dl>
              <details>
                <summary>Technical evidence</summary>
                <ul>
                  {repository.signals.map((signal) => (
                    <li>{signal}</li>
                  ))}
                </ul>
              </details>
              <div class="repository-actions">
                <a href={repository.url} target="_blank" rel="noopener noreferrer">
                  Inspect repository <span aria-hidden="true">↗</span>
                </a>
                {linkedProject && (
                  <a href={`${base}projects/${linkedProject.slug}/`}>
                    Engineering brief <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="repository-empty" data-repository-empty hidden>
      <h3>No repository matches those filters.</h3>
      <p>Reset the filters or search with a broader engineering term.</p>
    </div>
  </section>
</BaseLayout>
